# KnowFlow AI Environment Configuration

# Application
PROJECT_NAME="KnowFlow AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database
# SQLite (default development)
DATABASE_URL="sqlite+aiosqlite:///./knowflow.db"
# PostgreSQL (production alternative)
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/knowflow"

# RAG & Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=4
SIMILARITY_THRESHOLD=0.25

# Embedding Model Configuration
# 'local' uses built-in 384-dimensional dense semantic vector engine (no GPU or external API required)
# 'openai' uses text-embedding-3-small via OPENAI_API_KEY
EMBEDDING_PROVIDER="local"
EMBEDDING_MODEL="local-dense-384"

# LLM Provider Configuration
# Leave OPENAI_API_KEY blank to run in Demo Mode with grounded deterministic synthesis
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
LLM_MODEL="gpt-4o-mini"
